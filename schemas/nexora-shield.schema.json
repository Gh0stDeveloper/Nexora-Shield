{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gh0stDeveloper/Nexora-Shield/schemas/nexora-shield.schema.json",
  "title": "Nexora Shield configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "application", "profile"],
  "properties": {
    "schema": {
      "const": 1
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minSdk"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "minSdk": {
          "type": "integer",
          "minimum": 24
        }
      }
    },
    "profile": {
      "type": "string",
      "enum": ["standard", "hardened", "maximum"]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "diversity": { "type": "boolean" },
        "reproducible": { "type": "boolean" },
        "seedRef": { "type": "string", "minLength": 1 }
      }
    },
    "selectors": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/selector"
      }
    },
    "dex": {
      "type": "object",
      "additionalProperties": true
    },
    "crypto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "algorithm": {
          "type": "string",
          "const": "xchacha20poly1305-hkdf-sha256-v1"
        },
        "rootKeyRef": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to external secret material. Raw key material must not be stored in this configuration."
        },
        "stringThreshold": {
          "type": "string",
          "enum": ["internal", "sensitive", "critical"]
        },
        "forceProtect": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "forcePublic": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["disabled", "bounded"]
            },
            "maxEntries": {
              "type": "integer",
              "minimum": 1
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1
            },
            "ttlSeconds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "mode": { "const": "bounded" } },
                "required": ["mode"]
              },
              "then": {
                "required": ["maxEntries", "maxBytes", "ttlSeconds"]
              }
            }
          ]
        },
        "exposureMaxOverheadPercent": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataProtection": { "type": "boolean" },
        "include": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "maxResourceBytes": {
          "type": "integer",
          "minimum": 1
        },
        "allowAssets": { "type": "boolean" },
        "allowResRaw": { "type": "boolean" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "certificatePolicy": {
          "type": "string",
          "enum": ["exact_current", "current_or_lineage"]
        },
        "allowedSignerSha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowedLineageSha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "uniqueItems": true
        },
        "versionCode": {
          "type": "integer",
          "minimum": 0
        },
        "dexChunkBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "distributedChecks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "redundancy"],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 2
            },
            "redundancy": {
              "type": "integer",
              "minimum": 1
            },
            "seedRef": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "resourcePaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "nativePaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "responses": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "warning": {
              "type": "string",
              "enum": ["continue", "report", "require_reverification", "deny_sensitive_operation"]
            },
            "high": {
              "type": "string",
              "enum": ["continue", "report", "require_reverification", "deny_sensitive_operation"]
            },
            "critical": {
              "type": "string",
              "enum": ["continue", "report", "require_reverification", "deny_sensitive_operation"]
            }
          }
        }
      }
    },
    "rasp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": {
          "type": "string",
          "enum": ["enforce", "report_only"]
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["elevated", "high", "critical"],
          "properties": {
            "elevated": { "type": "integer", "minimum": 1 },
            "high": { "type": "integer", "minimum": 2 },
            "critical": { "type": "integer", "minimum": 3 }
          }
        },
        "responses": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clean": {
              "type": "string",
              "enum": ["continue", "report", "require_reverification", "deny_sensitive_operation"]
            },
            "observed": {
              "type": "string",
              "enum": ["continue", "report", "require_reverification", "deny_sensitive_operation"]
            },
            "elevated": {
              "type": "string",
              "enum": ["continue", "report", "require_reverification", "deny_sensitive_operation"]
            },
            "high": {
              "type": "string",
              "enum": ["continue", "report", "require_reverification", "deny_sensitive_operation"]
            },
            "critical": {
              "type": "string",
              "enum": ["continue", "report", "require_reverification", "deny_sensitive_operation"]
            }
          }
        }
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "apiLevel": {
          "type": "integer",
          "minimum": 24
        },
        "abis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["arm64-v8a", "x86_64", "armeabi-v7a", "x86"]
          }
        },
        "allow32Bit": { "type": "boolean" },
        "generatedData": { "type": "boolean" },
        "hardening": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pic": { "type": "boolean" },
            "relro": { "type": "boolean" },
            "bindNow": { "type": "boolean" },
            "gcSections": { "type": "boolean" },
            "stripSymbols": { "type": "boolean" },
            "hideArchiveSymbols": { "type": "boolean" },
            "disableBuildId": { "type": "boolean" }
          }
        }
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": true
    },
    "attestation": {
      "type": "object",
      "additionalProperties": true
    },
    "budgets": {
      "type": "object",
      "additionalProperties": true
    },
    "budgetsPolicy": {
      "type": "string",
      "enum": ["fail", "warn", "adaptive"]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": true
    },
    "reports": {
      "type": "object",
      "additionalProperties": true
    },
    "signing": {
      "type": "object",
      "additionalProperties": true
    },
    "secrets": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
